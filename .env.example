# EcoSeek — example environment file.
#
#   cp .env.example .env
#   docker compose up -d
#
# Mirrors the keys that setup.sh generates (setup.sh is the source of truth
# and auto-fills EMILY_API_KEY, so the value here is just a placeholder).
# Secrets stay EMPTY by default — fill them in for cloud LLM providers.

# Compose profile selector (cpu = default CPU Ollama; gpu = NVIDIA passthrough)
COMPOSE_PROFILES=cpu

# Ports
ECOSEEK_API_PORT=3000
ECOAGENT_PORT=8000
OLLAMA_PORT=11434
PHOENIX_PORT=6006

# Local model
OLLAMA_MODEL=tinyllama
# Base URL only; ecoseek-api appends /v1/chat/completions
LOCAL_LLM_URL=http://ollama:11434

# Adaptive Autonomous Retrieval
ECOSEEK_AAR_ENABLED=false
ECOSEEK_JUDGE_MODEL=auto

# Phoenix observability (optional profile)
PHOENIX_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=ecoseek

# Hermes remote (DiDAL escalation, optional)
# Set HERMES_REMOTE_URL (e.g. https://hermes.ecoseek.org) and
# HERMES_ECOSEEK_API_KEY to let Emily escalate to a remote Hermes
# orchestrator. Leave empty for fully local operation.
HERMES_REMOTE_URL=
HERMES_ECOSEEK_API_KEY=

# BYOK — empty by default; fill in to use DeepSeek cloud
DEEPSEEK_API_KEY=

# Emily API key — shared secret between the frontend proxy and the
# Emily backend (port 8642). The frontend's nginx injects it as the
# server-side Bearer token (EMILY_HERMES_KEY defaults to this), and
# the Emily backend validates it as API_SERVER_KEY. Must be non-empty
# or the frontend refuses to start (avoids silent HTTP 401 on chat).
# setup.sh auto-generates a random value — leave empty here.
EMILY_API_KEY=
# Override only if the backend on :8642 uses a different key than
# EMILY_API_KEY (e.g. a host hermes process). Defaults to EMILY_API_KEY.
EMILY_HERMES_KEY=

# Gateway authorization: the Hermes gateway denies ALL users when no user
# allowlists are configured. true = anyone can chat (self-hosted DIY product,
# works out of the box). Set to false and configure Hermes user allowlists
# to restrict who can chat.
GATEWAY_ALLOW_ALL_USERS=true

# Literature search (Meilisearch): OFF by default — the stack ships no
# Meilisearch service. To enable, run your own Meilisearch and set
# MEILI_URL (default http://meilisearch:7700) and MEILI_INDEX
# (default gbif_literature), then set MEILI_ENABLED=true.
MEILI_ENABLED=false

# NCBI Entrez / PubMed API key (optional)
# Without key: 3 req/s. With key: 10 req/s.
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
ENTREZ_API_KEY=
ENTREZ_EMAIL=ecoseek@ecoseek.org

# Upstream timeout (seconds) — applied to all gateway upstream calls
UPSTREAM_TIMEOUT_S=30